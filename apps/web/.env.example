# CineMint's own Supabase project only.
# These values are browser-visible; use a dedicated project, never another app's credentials.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Public canonical origin used to build email confirmation callback URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only integrations. Never prefix these with NEXT_PUBLIC_.
GEMINI_API_KEY=
TMDB_API_READ_ACCESS_TOKEN=
